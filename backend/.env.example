# Copy this file to `.env` for local dev. On Railway, set these as Service Variables instead.

ENV=development
SECRET_KEY=replace-with-a-long-random-string
FRONTEND_URL=http://localhost:5173

# --- Database (Railway auto-injects DATABASE_URL if you use its Postgres plugin;
#     just make sure it's the asyncpg-style URL, e.g. postgresql+asyncpg://...) ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/smartprepai
REDIS_URL=redis://localhost:6379/0

# === INTEGRATION POINT: MyQuest (past questions) ===
MYQUEST_API_KEY=
MYQUEST_BASE_URL=https://api.myquest.example.com

# === INTEGRATION POINT: Paystack (payments) ===
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxx

# === INTEGRATION POINT: Groq (free/fast LLM for the AI tutor) ===
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# === INTEGRATION POINT: Qdrant (open-source vector DB) ===
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=smartprepai_textbooks
EMBEDDING_MODEL=BAAI/bge-m3
